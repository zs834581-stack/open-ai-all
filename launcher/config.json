{
  "newApi": {
    "exePath": "./new-api.exe",
    "port": 3000,
    "dataDir": "./data",
    "env": {
      "TZ": "Asia/Shanghai",
      "SESSION_SECRET": "change_me_to_random"
    }
  },
  "chat2api": {
    "exePath": "./chat2api/Chat2API.exe",
    "port": 8080,
    "enabled": true,
    "autoStart": true
  },
  "nodeServices": [
    { "name": "deepseek-free-api", "dir": "./free-api/deepseek-free-api", "port": 8001, "cmd": "npm start", "enabled": false },
    { "name": "glm-free-api",     "dir": "./free-api/glm-free-api",     "port": 8002, "cmd": "npm start", "enabled": false }
  ],
  "autoOpenWebUI": true,
  "webUIPath": "/"
}
